{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sqlite": {
      "command": "node",
      "args": ["scripts/mcp-inventory-server.mjs"],
      "env": {
        "AUDIT_DB_PATH": "data/freshflow.db"
      },
      "disabled": false,
      "autoApprove": [
        "get_perishable_inventory",
        "fetch_open_meteo_weather",
        "evaluate_batch_markdown",
        "route_donation_manifest",
        "calculate_arrhenius_decay",
        "query_audit_trail"
      ]
    },
    "freshflow-inventory": {
      "command": "node",
      "args": ["scripts/mcp-inventory-server.mjs"],
      "env": {
        "AUDIT_DB_PATH": "data/freshflow.db"
      },
      "disabled": false,
      "autoApprove": ["*"]
    },
    "fetch": {
      "command": "node",
      "args": ["scripts/mcp-fetch-server.mjs"],
      "disabled": false,
      "autoApprove": ["fetch"]
    }
  }
}
